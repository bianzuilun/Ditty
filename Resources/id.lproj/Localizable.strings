/* Peringatan */
"Delete all clips?" = "Hapus semua klip?";
"This removes every saved copy except sticky clips, clips marked Never Auto Delete and clips inside groups. It cannot be undone." = "Ini menghapus semua salinan tersimpan kecuali klip yang disematkan, klip bertanda Jangan Hapus Otomatis, dan klip di dalam grup. Tindakan ini tidak bisa dibatalkan.";
