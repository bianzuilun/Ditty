/* Hinweise */
"Delete all clips?" = "Alle Einträge löschen?";
"This removes every saved copy except sticky clips, clips marked Never Auto Delete and clips inside groups. It cannot be undone." = "Dies entfernt alle gespeicherten Kopien – außer angehefteten Einträgen, Einträgen mit „Nie automatisch löschen“ und Einträgen in Gruppen. Lässt sich nicht rückgängig machen.";
"Delete" = "Löschen";
"Cancel" = "Abbrechen";
"Ditty needs the Accessibility permission to paste for you" = "Ditty benötigt die Bedienungshilfen-Berechtigung, um für dich einzusetzen";
"The clip is on your clipboard, so you can press ⌘V yourself right now.\n\nTo let Ditty paste automatically, turn on Ditty under System Settings → Privacy & Security → Accessibility." = "Der Eintrag liegt bereits in deiner Zwischenablage, du kannst also selbst ⌘V drücken.\n\nDamit Ditty automatisch einsetzt, aktiviere Ditty unter Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen.";
"Open System Settings" = "Systemeinstellungen öffnen";
"Not Now" = "Nicht jetzt";

